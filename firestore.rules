rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usernames Collection Security Rules
    // Each doc id is the lowercase username; used to enforce global
    // uniqueness and to look up a uid by username for chat search.
    match /usernames/{usernameLower} {
      // Anyone signed in can check availability / resolve a username.
      allow read: if request.auth != null;

      // A user may only reserve a username for THEIR OWN uid, and only
      // once (the document must not already exist).
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && usernameLower.matches('^[a-z0-9_]{3,20}$');

      // Only the owner of the reservation can release it (e.g. account
      // deletion). No renaming-in-place — release then reserve a new one.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    // Users Collection Security Rules
    match /users/{userId} {
      // Any authenticated user can read public profiles to initiate
      // chats, search by username, and verify identity keys.
      allow read: if request.auth != null;

      // Users can only create or update their OWN profile document.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower == request.resource.data.usernameLower.lower()
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 90
        && request.resource.data.publicKey is string
        && request.resource.data.publicKey.size() <= 100
        && (!('isOnline' in request.resource.data) || request.resource.data.isOnline is bool)
        // Real ECDH public key (JSON Web Key, JSON-stringified) used for
        // end-to-end encryption — see src/lib/crypto.ts.
        && (!('publicKeyJwk' in request.resource.data)
          || (request.resource.data.publicKeyJwk is string && request.resource.data.publicKeyJwk.size() <= 1000));

      // Prevent client-side document deletion (account deletion flow
      // removes it via a signed-in delete request, see below).
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Chats Collection Security Rules
    match /chats/{chatId} {
      // Allow read if authenticated and user is one of the participants.
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.participantIds);

      // Allow create if authenticated and user is listed in participantIds.
      allow create: if request.auth != null
        && (request.auth.uid in request.resource.data.participantIds)
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 256;

      // Allow update if authenticated participant (last message preview,
      // unread counts, pinned/muted-by-me, typing, read receipts, group info).
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.participantIds)
        && (request.auth.uid in request.resource.data.participantIds);

      // Prevent client-side chat deletion.
      allow delete: if false;

      // Messages Subcollection Security Rules
      match /messages/{messageId} {
        // Allow read if user is a participant of the parent chat.
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);

        // Allow create if user is the sender and a participant of the chat.
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);

        // Allow update if participant (reactions, star, delete-for-everyone).
        allow update: if request.auth != null
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
          && request.resource.data.senderId == resource.data.senderId;

        // Allow the sender to delete their own message outright (delete
        // for me); "delete for everyone" is a soft-delete via update.
        allow delete: if request.auth != null
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Calls Collection Security Rules (WebRTC signaling)
    match /calls/{callId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.callerId
        && request.resource.data.calleeId is string
        && request.resource.data.status == 'ringing';

      // Either party can update status (accept/decline/end/busy) and the
      // callee writes the answer SDP; the caller writes the offer at
      // create time only.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId;

      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/calls/$(callId))
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
            || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/calls/$(callId))
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/calls/$(callId))
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
            || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/calls/$(callId))
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId;
        allow update, delete: if false;
      }
    }

    // Default deny all other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
